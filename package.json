{
  "name": "beshort",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "security:audit": "powershell -ExecutionPolicy Bypass -File scripts/security-audit.ps1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "mcp:build": "npm --prefix mcp-server run build"
  },
  "dependencies": {
    "fastify": "^5.3.0",
    "zod": "^3.24.1",
    "nanoid": "^5.0.7",
    "@prisma/client": "^6.2.0",
    "prisma": "^6.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
