{
  "$schema": "https://opencode.ai/config.json",
  "model": "orcarouter/orcarouter/auto",
  "provider": {
    "orcarouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OrcaRouter",
      "options": {
        "baseURL": "https://api.orcarouter.ai/v1",
        "apiKey": "{env:ORCAROUTER_API_KEY}"
      },
      "models": {
        "orcarouter/auto": { "name": "OrcaRouter Auto" }
      }
    }
  },
  "skills": {
    "paths": ["./.opencode/skills"]
  },
  "mcp": {
    "vibe-coding": {
      "type": "local",
      "command": ["node", "./mcp-server/dist/index.js"],
      "enabled": true
    }
  },
  "commands": {
    "dev": "npm run dev",
    "test": "npm test",
    "build": "npm run build",
    "lint": "npm run lint --fix",
    "typecheck": "npx tsc --noEmit",
    "security:audit": "powershell -ExecutionPolicy Bypass -File scripts/security-audit.ps1"
  }
}

